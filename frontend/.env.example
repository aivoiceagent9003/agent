# Base URL of the voice-agent Express backend the dashboard talks to.
# Local dev: the backend runs on http://localhost:3000 (see backend PORT).
# Production: set this to your deployed API origin.
VITE_API_BASE=http://localhost:3000

# Google OAuth Client ID for "Sign in with Google" (Google Cloud Console →
# Credentials → OAuth 2.0 Client ID, type "Web application"). Public by design —
# safe to expose in the browser bundle. If unset, the Google button is hidden and
# only email/password auth is shown.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
