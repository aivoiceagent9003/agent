NGROK_URL=your-ngrok-subdomain.ngrok-free.app

# ─── REQUIRED IN PRODUCTION ───────────────────────────────────────────────────
# The server refuses to boot with NODE_ENV=production unless all three are set.
# Each one fails open in a way that is invisible at runtime, which is exactly why
# a missing value has to stop the deploy instead of degrading it.

# Shared secret authenticating provider webhooks and media streams. Plivo's request
# signature is not verified here, so the secret rides in the URL and every telephony
# endpoint checks it. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ After setting this, update the URLs in the Plivo console to carry ?k=<secret>:
#     answer  →  https://<PUBLIC_HOST>/answer?k=<secret>
#     hangup  →  https://<PUBLIC_HOST>/hangup?k=<secret>
#   Without the suffix Plivo gets a 403 and calls will not connect. The campaign
#   answer URL and both media-stream URLs are built in code and carry it already.
WEBHOOK_SECRET=

# Comma-separated origins allowed to call this API from a browser. Never a
# wildcard — this API accepts an Authorization header, and `*` alongside
# credentials lets any site drive the dashboard API with a victim's token.
FRONTEND_ORIGIN=https://app.yourdomain.com

# Public hostname the telephony provider reaches us on. Replaces NGROK_URL in the
# call path; ngrok remains the dev fallback only.
# (also used by campaigns — see the Campaign Automation section below)

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# The voice engine's three providers (see "Voice engine" below):
# Sarvam hears the caller. It also renders campaign "Template Call" messages
# (src/services/tts.js) — fixed spoken blasts, no conversation.
SARVAM_API_KEY=sk_your_sarvam_key
# Gemini is the brain. It authenticates with this API key, not with a service-account
# file. There is no GOOGLE_APPLICATION_CREDENTIALS in this stack.
GOOGLE_AI_API_KEY=your_google_ai_key
# Telnyx speaks every reply.
TELNYX_API_KEY=your_telnyx_key
# OpenAI never runs during a call: it embeds uploaded documents, extracts the lead
# after a call, and drafts agent prompts.
OPENAI_API_KEY=sk-proj-your_openai_key

# ─── Transactional email (welcome message on signup) ─────────────────────────
# Plain SMTP, so ANY provider works — Gmail, Resend, SendGrid, Brevo, SES.
#   Gmail:  host=smtp.gmail.com port=587 user=<your@gmail.com>
#           pass=<16-char APP PASSWORD from Google Account → Security → App passwords;
#           requires 2-Step Verification. NOT your normal Gmail password.>
#   Resend: host=smtp.resend.com port=587 user=resend pass=<re_... api key>
# Leave blank to disable email — signup still works, it just logs and skips.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the sender. Defaults to SMTP_USER. Gmail requires this to be your own address.
EMAIL_FROM=AnswerLabs <you@gmail.com>
# Dashboard base URL used for links inside emails
APP_URL=http://localhost:8080


# ─── Public "try it live" demo on the marketing site ─────────────────────────
# Anonymous visitors talk to a real agent in the browser, so every session costs
# money. These caps bound the spend. Set DEMO_ENABLED=false to switch it off.
DEMO_ENABLED=true
DEMO_MAX_SECONDS=90            # hard stop per industry demo call
DEMO_VOCERA_MAX_SECONDS=600    # longer cap for "Talk to Priya" (she explains the product)
DEMO_MAX_CONCURRENT=5          # simultaneous demo sessions across all visitors
DEMO_MAX_PER_IP_PER_HOUR=3     # demo calls one visitor can start per hour
# Rupees per dollar, for the per-call cost line logged at hangup ("💰 call cost ≈ ₹…")
# and stored in call_traces.summary.usage. A static constant that drifts — every ₹
# figure scales with it.
# USD_INR=95.97

# ─── Voice engine ─────────────────────────────────────────────────────────────
# One engine, for every call the platform makes: phone calls, the marketing demo, the
# builder's test call and outbound campaigns (src/services/cascade.js):
#   Sarvam STT → Gemini → Telnyx TTS
# It logs a latency breakdown per turn and a cost per call. A browser gets 16kHz PCM in
# and 24kHz PCM out instead of the 8kHz telephony codec — same engine, better audio.
#
# Listening. Sarvam ends a caller's turn on a silence timer, ~1.3s after the last word.
# SARVAM_STT_SILENCE_MS=600         # 500 split a turn at an ordinary gap between sentences;
#                                   # 800 costs ~250ms more per turn.
# SARVAM_STT_MODEL=saaras:v3-realtime   # saaras:v4 measured no faster
# SARVAM_STT_MODE=codemix           # English words in English letters inside Telugu/Hindi
# SARVAM_STT_KEYTERMS=              # saaras:v4 ONLY — comma-separated words to favour. On v3
#                                   # they make Sarvam refuse the session, so they are dropped;
#                                   # the tenant's product names go as a prompt instead.
#
# Thinking. Replaying a real call, gemini-3.5-flash-lite searched the knowledge base on
# 4 of 6 factual questions and answered from it; gpt-4o-mini searched on 0 of 6 and
# made answers up.
# CASCADE_LLM_MODEL=gemini-3.5-flash-lite
# The ~10,900-token prompt (rules + tool schemas) is held on Google's side
# (src/services/gemini-cache.js). 3.5-flash-lite does no implicit caching; the explicit
# cache bills input at $0.03/1M instead of $0.30/1M. It takes ~2.6s to create, so the
# first turns of a call run inline, and it is never waited on. Storage bills ~$0.011/hour
# per cache, so the TTL lets an idle tenant lapse.
# GEMINI_EXPLICIT_CACHE=false       # send the prompt inline on every request instead
# GEMINI_CACHE_TTL_SECONDS=900      # how long a cache lives before it must be rebuilt
#
# Speaking. Telnyx Ultra is Cartesia Sonic-3 resold (its Telugu voice ids ARE Cartesia's).
# Replaying 12 real replies: 0 mid-reply gaps, first audio ~0.8s. REST only, MP3 only —
# decoded in-process (mpg123-decoder) to the caller's format. There is no second voice:
# a refusal is silence, and a 402 (balance) raises a critical alert.
# TELNYX_TTS_VOICE=Telnyx.Ultra.cf061d8b-a752-4865-81a2-57570a6e0565   # "Ramya", Telugu female.
#                                   # Server default; a tenant's pick in the portal wins. Other
#                                   # Telugu Ultra voices: 07bc462a-c644-49f1-baf7-82d5599131be (Sindhu),
#                                   # 3a8e6fea-81e5-4d4d-8755-86093146cdb8 (Vidya), 4418bb06-8329-49a1-bb11-53bb64ca0547 (Shanti)
# TELNYX_TTS_MAX_CONCURRENT=10      # sentences synthesised at once, across every call in the process
#
# CASCADE_ACK=false                 # stop speaking while a slow lookup runs. ON by default:
#                                   # measured, a knowledge turn left the caller with ~4.5s of
#                                   # silence and this cuts it to ~2.3s without delaying the
#                                   # answer. Only fires when a lookup is ACTUALLY running and
#                                   # the model has not written its own lead-in — see
#                                   # services/acknowledgements.js.
# CASCADE_ACK_WARM_DELAY_MS=2500    # when to render the acknowledgement lines into the
#                                   # per-process cache: after the greeting has been spoken.
# CASCADE_KB_CHUNKS=6               # chunks per knowledge search. 3 made the model round-trip twice.
# RAG_EMBEDDER=local                # who turns a knowledge search into numbers: openai (the default
#                                   # when unset) or local — multilingual-e5-small on this server
#                                   # (src/services/local-embed.js). On GSK's catalogue: ~10ms vs
#                                   # 385-943ms per search on live calls, and the wrong Secure/Supreme
#                                   # variant ranked first 1/126 times vs 15/126. Documents still come
#                                   # from Supabase; each chunk is embedded once (~43s for 634, in the
#                                   # background — OpenAI answers meanwhile) and remembered in .cache/.
#                                   # The model (~130MB) downloads on first use; bake .cache/models into
#                                   # a deploy image.
# RAG_LOCAL_MIN_SIMILARITY=0.83     # weaker matches are dropped. e5 scores high across the board:
#                                   # answerable 0.84-0.95, off-topic 0.76-0.85 on GSK.
# RAG_LOCAL_MODEL=Xenova/multilingual-e5-small
# RAG_LOCAL_CACHE_DIR=.cache
# CASCADE_BARGE_IN_MIN_WORDS=2      # words over the agent before it stops talking
# CASCADE_HISTORY_TOOL_TURNS=2      # caller turns a long lookup result stays in the history
#                                   # the model re-reads; older ones become a one-line note.
# CASCADE_HISTORY_MAX_TURNS=24      # caller turns kept at all; older turns are dropped whole.
#
# Cost estimate rates (USD), for the per-call cost line. The LLM rates default to the
# list price of CASCADE_LLM_MODEL (src/services/cascade-cost.js).
# SARVAM_STT_PRICE_PER_HOUR=0.30
# TELNYX_TTS_PRICE_PER_CHAR=0.000032   # per character, vowel signs free — not per second
# CASCADE_LLM_PRICE_IN=0.30
# CASCADE_LLM_PRICE_CACHED_IN=0.03
# CASCADE_LLM_PRICE_OUT=2.50
# What the carrier charges. Without it the cost line reports only what the AI
# providers bill, and reads lower than the invoice. Carriers bill in BLOCKS, not minutes: Plivo India inbound
# is Rs 0.19 per 30 seconds and every block a call touches is charged in full, so a
# 31-second call pays for 60. Priced per-minute instead, that call reads Rs 0.20 against
# a real Rs 0.38 — and the error is worst on short calls, which already have the
# thinnest margin. Set the block rate; PER_MIN is only for a carrier that bills per second.
# Plivo Voice API, India, inbound AND outbound (they are the same rate):
TELEPHONY_INR_PER_BLOCK=0.19
TELEPHONY_BLOCK_SECONDS=30
#
# Plivo Zentrunk (SIP trunking), India: Rs 0.248 per MINUTE. Express it as a 60-second
# block so the rounding is modelled too. Measured against four real calls it is 32%
# cheaper than the Voice API rate above, because a 3-minute call pays 3 whole minutes
# instead of 6 half-minute blocks. It LOSES below ~45s, where one 30s block beats one
# whole minute — so this is only the cheaper route while calls stay long.
#   TELEPHONY_INR_PER_BLOCK=0.248
#   TELEPHONY_BLOCK_SECONDS=60
#
# NOT included here: number rental, Rs 200 per Indian number per month. It is a fixed
# monthly per tenant, not a per-call cost, so it belongs in the plan maths rather than
# in a call cost line.
# TELEPHONY_INR_PER_MIN=0.64

PORT=3000

# ─── Hanging up ───────────────────────────────────────────────────────────────
# The agent ends the call itself once both sides have said goodbye (the end_call
# tool), instead of leaving the caller to hang up.
#
# We push audio to the provider far faster than real time, so at the moment the
# model stops generating, several seconds of speech can still be queued at the
# caller's ear. The line is held until they have heard it all, plus this margin,
# which covers the provider's own jitter buffer. Raise it if the last syllable of
# a goodbye ever gets clipped; it costs nothing but a little dead air.
# HANGUP_TAIL_MS=700
#
# Backstop for a hangup the model asked for but never finished speaking (a stalled
# generation, a dropped session). Without it the caller sits on an open line.
# HANGUP_STALL_MS=15000


# ─── Conversation language control ────────────────────────────────────────────
# The APPLICATION owns the conversation language, not Gemini (see
# src/services/language-manager.js). Every value below exists to make a WRONG
# switch harder — staying in the current language one extra turn is always better
# than switching incorrectly, so raise these rather than lower them.
#
# Confidence a DIFFERENT language needs before it even becomes a candidate.
# LANGUAGE_SWITCH_CONFIDENCE=0.80
# Confidence needed to establish the language on the first meaningful utterance.
# Slightly lower: there is no established language to protect yet.
# LANGUAGE_INITIAL_CONFIDENCE=0.75
# Consecutive meaningful utterances agreeing on the new language before switching.
# LANGUAGE_CONFIRMATION_COUNT=2
# After a switch, implicit signals are ignored this long. Explicit caller requests
# ('speak in English') always bypass it. This is what stops te→hi→te→hi.
# LANGUAGE_SWITCH_COOLDOWN_MS=7000
# Recent meaningful utterances sent to the classifier as context.
# LANGUAGE_CONTEXT_WINDOW=3
# Hysteresis: evidence FOR the current language counts at this much lower bar.
# LANGUAGE_MAINTAIN_CONFIDENCE=0.55
# Classifier model + resilience. On timeout/failure the language NEVER changes.
# GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite
# LANGUAGE_CLASSIFY_TIMEOUT_MS=2500
# LANGUAGE_CLASSIFY_BACKOFF_MS=8000
# Process-wide cap on concurrent classifier calls (shared quota across all calls).
# LANG_MAX_CONCURRENT_CLASSIFY=4
# Reply-gate: hold the model's first reply while a SYNCHRONOUS language decision
# resolves. LANG_GATE_DISABLED=1 turns the gate off entirely.
# LANG_GATE_HOLD_MS=600

# ─── Process lifecycle ────────────────────────────────────────────────────────
# How long to let live calls finish after SIGTERM before exiting. Set your
# platform's termination grace period HIGHER than this, or it hard-kills the
# process mid-drain and you lose the transcripts anyway.
SHUTDOWN_GRACE_MS=15000
# On boot, any call row still 'active' and older than this is marked 'interrupted'.
# These are calls stranded by a previous hard kill.
ORPHAN_CALL_HOURS=2

# ─── Compliance (DPDP 2023 / TRAI) ────────────────────────────────────────────
# Default retention window. Per-tenant override lives in tenants.config.retention_days.
# Past this, recordings are deleted, transcripts erased, and caller numbers redacted.
DEFAULT_RETENTION_DAYS=90
# How often the retention pass runs. Runs in the worker (or the inline runner when
# Redis is absent) — never in every API replica.
RETENTION_INTERVAL_MS=86400000
# Salt for hashing phone numbers in the erasure audit trail. Falls back to
# WEBHOOK_SECRET. Changing it orphans existing audit rows from their lookups.
DSR_HASH_SALT=

# ─── Abuse limits ─────────────────────────────────────────────────────────────
# Per-tenant ceiling on knowledge documents. Embedding spend is otherwise
# unbounded per tenant. Becomes a per-plan value once billing lands.
MAX_DOCUMENTS_PER_TENANT=200
# How long a media-stream ticket stays valid between /answer and the WS 'start'.
# Tickets are single-use; this only bounds how long an unused one lingers.
CALL_TICKET_TTL_MS=60000

# ─── Campaign Automation ──────────────────────────────────────────────────────
# Public host the telephony provider calls back to / streams to (defaults to NGROK_URL).
PUBLIC_HOST=your-ngrok-subdomain.ngrok-free.app
# Redis is OPTIONAL. Leave REDIS_URL unset and campaigns run IN-PROCESS (no separate
# worker, no Redis) via the inline runner — fine for a single instance. Set REDIS_URL
# + run `npm run worker` to scale out / get cron-durable schedules. Managed Redis needs
# TLS: use rediss:// (two s's), not redis://.  Force off with CAMPAIGN_RUNNER=off.
# CAMPAIGN_RUNNER=auto            # auto (default) | off
# REDIS_URL=rediss://default:<password>@<host>:<port>
REDIS_URL=
# ─── Telephony: Plivo ─────────────────────────────────────────────────────────
# Plivo Call API — from the Plivo Console (Account → Keys & Credentials):
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Optional override; defaults to https://api.plivo.com/v1/Account/<AUTH_ID>/Call/
PLIVO_OUTBOUND_URL=
# Optional override for the live-call transfer endpoint (human handoff). Use
# {call_uuid} as the placeholder; defaults to the Call API URL above + the uuid:
PLIVO_TRANSFER_URL=

# The webhook URLs you configure in the Plivo console MUST carry the shared
# secret as ?k=<WEBHOOK_SECRET>, or every call is rejected with a 403:
#   Answer URL:  https://<PUBLIC_HOST>/answer?k=<WEBHOOK_SECRET>   [POST]
#   Hangup URL:  https://<PUBLIC_HOST>/hangup?k=<WEBHOOK_SECRET>   [POST]
# There is no /fallback route — leave the console's fallback URL empty.
# Default country code for bare 10-digit numbers on import
DEFAULT_COUNTRY_CODE=91
# Worker concurrency + provider rate limiting
DIAL_CONCURRENCY=25
BROADCAST_CONCURRENCY=50
DIAL_RATE_MAX=30
DIAL_RATE_DURATION_MS=1000
# Cost/price per minute for campaign economics
COST_PER_MIN_USD=0.08
PRICE_PER_MIN_USD=0.30

# ─── WhatsApp (platform-wide sender — one number for all tenants) ──────────────
# Messages send from THIS number; each client's business name/contact ride in the
# template body. Create two GENERIC templates on this WABA (work for any industry —
# the specifics live in variable {{2}}, supplied by the agent):
#   document     : {{1}} customer, {{2}} what it is ("brochure for X"/"menu"/"price list"),
#                  {{3}} business name, {{4}} contact  (+ a DOCUMENT header)
#   confirmation : {{1}} customer, {{2}} what ("site visit to X"/"appointment"), {{3}} date,
#                  {{4}} time, {{5}} contact
WHATSAPP_PROVIDER=meta            # meta | 360dialog
WHATSAPP_WABA_ID=                 # WhatsApp Business Account ID (for listing templates)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_BASE=               # optional; blank = provider default
WHATSAPP_DEFAULT_LANG=en
WHATSAPP_TEMPLATE_DOCUMENT=
WHATSAPP_TEMPLATE_CONFIRMATION=
# Which value fills {{1}},{{2}},… in YOUR template — so any template layout works
# without code changes. Tokens: customer | about | topic | business | phone | date | time
# Leave blank to use the defaults, which match the generic templates above:
#   document     = customer,about,business,phone
#   confirmation = customer,about,date,time,phone
WHATSAPP_DOCUMENT_PARAMS=
WHATSAPP_CONFIRMATION_PARAMS=

# ─── Self-serve password signup ───────────────────────────────────────────────
# Signup is Google-only in the product: the signup page offers a Google button and
# nothing else, and no UI calls POST /api/signup. That route stayed public anyway
# and minted PRE-CONFIRMED accounts, so anyone could register an address they did
# not own and have it treated as verified. It is now off unless you opt in.
# When enabled, the account is created UNCONFIRMED and Supabase emails a
# confirmation link — sign-in is refused until the address is proven.
ALLOW_PASSWORD_SIGNUP=false

# ─── Alert delivery ───────────────────────────────────────────────────────────
# The alert engine has always DETECTED problems correctly. Without one of these it
# could not tell anyone: alerts lived in memory and a websocket event, visible only
# to someone already watching the Operations Center. A 3am crash reached nobody.
#
# Slack incoming webhook. Create one at https://api.slack.com/messaging/webhooks
#   Slack → Your Apps → Create New App → From scratch → pick the workspace
#   → Incoming Webhooks → Activate → Add New Webhook to Workspace → pick a channel
#   → copy the https://hooks.slack.com/services/... URL here.
#
# A hooks.slack.com URL gets rich formatting automatically: a coloured bar (red
# for critical, green for a resolve), the stack trace in a code block, and
# severity + environment as fields. Any other URL receives a flat JSON payload
# instead, carrying both "text" and "content" so Slack-likes and Discord both work.
#
# Verify it before you need it:  npm run alert:test
ALERT_WEBHOOK_URL=
# Comma-separated recipients. Uses the SMTP configured above; if SMTP is unset this
# is announced as inert at boot rather than failing silently.
ALERT_EMAIL_TO=
# Minimum severity that notifies: info | warning | error | critical.
# Default 'critical'. Warnings belong on the dashboard — paging for a CPU blip is
# how a pager gets muted, and a muted pager is worse than none because it is
# believed to be working.
ALERT_MIN_SEVERITY=critical
# Quiet period per alert after a send, so a threshold hovering at its limit sends
# once rather than on every flap.
ALERT_COOLDOWN_MS=900000
# Hard timeout on a single webhook/email send.
ALERT_SEND_TIMEOUT_MS=5000
# Ceiling on how long a crashing process stays alive to deliver its crash
# notification before exiting non-zero anyway.
CRASH_EXIT_DELAY_MS=6000
# Shown in the notification subject line, so several environments are tellable apart.
APP_NAME=AnswerLabs
